# ---------- MySQL (banco transacional / ERP agrícola) ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=agrosentinela

# ---------- MongoDB (documentos: alertas, dados brutos, log do ETL) ----------
# Local: mongodb://localhost:27017   |  Atlas: mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net/
MONGO_URI=mongodb://localhost:27017
MONGO_DB=agrosentinela

# ---------- Arquivos locais ----------
# SQLite = caderno de campo offline (app do celular do técnico)
SQLITE_PATH=dados/caderno_campo.db
# DuckDB = data warehouse analítico (modelo estrela)
DUCKDB_PATH=dados/dw_agrosentinela.duckdb

# ---------- Apache Hop (opcional) ----------
# Se informado, o botão "Executar integração" roda o workflow do Hop.
# Se vazio, a coleta de clima é feita pelo coletor Python equivalente.
# Windows ex.: C:\hop    Linux ex.: /opt/hop
HOP_HOME=

# ---------- Avançado ----------
# Endereço da API de previsão (deixe vazio para usar https://api.open-meteo.com/v1/forecast)
OPEN_METEO_URL=
