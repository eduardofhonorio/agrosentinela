<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>coleta_clima</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Coleta histórico (30 dias) e previsão (hoje + 7 dias) da API Open-Meteo para cada talhão e grava na staging MySQL</description>
    <extended_description/>
    <pipeline_version>1.0</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>MYSQL_HOST</name>
        <default_value>localhost</default_value>
        <description>Servidor MySQL</description>
      </parameter>
      <parameter>
        <name>MYSQL_PORT</name>
        <default_value>3306</default_value>
        <description>Porta</description>
      </parameter>
      <parameter>
        <name>MYSQL_DB</name>
        <default_value>agrosentinela</default_value>
        <description>Banco</description>
      </parameter>
      <parameter>
        <name>MYSQL_USER</name>
        <default_value>root</default_value>
        <description>Usuário</description>
      </parameter>
      <parameter>
        <name>MYSQL_PASSWORD</name>
        <default_value>root</default_value>
        <description>Senha</description>
      </parameter>
      <parameter>
        <name>OPEN_METEO_URL</name>
        <default_value>https://api.open-meteo.com/v1/forecast</default_value>
        <description>Endpoint da API de previsão</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>AgroSentinela</created_user>
    <created_date>2026/11/16 10:00:00.000</created_date>
    <modified_user>AgroSentinela</modified_user>
    <modified_date>2026/11/16 10:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>210</backgroundcolorblue>
      <backgroundcolorgreen>245</backgroundcolorgreen>
      <backgroundcolorred>220</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>140</bordercolorgreen>
      <bordercolorred>60</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>40</fontcolorblue>
      <fontcolorgreen>60</fontcolorgreen>
      <fontcolorred>30</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Segoe UI</fontname>
      <fontsize>10</fontsize>
      <height>90</height>
      <xloc>64</xloc>
      <yloc>32</yloc>
      <note>AgroSentinela - Coleta de clima
1) Lê os talhões ativos (com latitude/longitude) no MySQL e monta a URL da API
2) Chama a API Open-Meteo (REST) uma vez por talhão
3) Converte o JSON (arrays diários) em linhas: 38 linhas por talhão
4) Grava/atualiza a staging clima_diario no MySQL (chave talhao_id + data)</note>
      <width>560</width>
    </notepad>
  </notepads>
  <order>
    <hop><from>Talhões (MySQL)</from><to>API Open-Meteo</to><enabled>Y</enabled></hop>
    <hop><from>API Open-Meteo</from><to>Resposta OK?</to><enabled>Y</enabled></hop>
    <hop><from>Resposta OK?</from><to>JSON diário -&gt; linhas</to><enabled>Y</enabled></hop>
    <hop><from>Resposta OK?</from><to>Falhas da API</to><enabled>Y</enabled></hop>
    <hop><from>JSON diário -&gt; linhas</from><to>Gravar clima_diario</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Talhões (MySQL)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>agro_mysql</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT
  talhao_id,
  codigo,
  CONCAT('${OPEN_METEO_URL}',
         '?latitude=', latitude,
         '&amp;longitude=', longitude,
         '&amp;daily=temperature_2m_max,temperature_2m_min,precipitation_sum,et0_fao_evapotranspiration,wind_speed_10m_max,relative_humidity_2m_mean,precipitation_probability_max',
         '&amp;past_days=30&amp;forecast_days=8&amp;timezone=America%2FSao_Paulo') AS url,
  'apache-hop' AS carregado_por,
  NOW()        AS atualizado_em
FROM vw_talhoes_coordenadas
ORDER BY talhao_id</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>API Open-Meteo</name>
    <type>Rest</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <applicationType>JSON</applicationType>
    <method>GET</method>
    <url/>
    <urlInField>Y</urlInField>
    <dynamicMethod>N</dynamicMethod>
    <methodFieldName/>
    <urlField>url</urlField>
    <bodyField/>
    <httpLogin/>
    <httpPassword>Encrypted </httpPassword>
    <proxyHost/>
    <proxyPort/>
    <preemptive>N</preemptive>
    <trustStoreFile/>
    <trustStorePassword>Encrypted </trustStorePassword>
    <ignoreSsl>N</ignoreSsl>
    <headers>
      </headers>
    <parameters>
      </parameters>
    <matrixParameters>
      </matrixParameters>
    <result>
      <name>response</name>
      <code>status_http</code>
      <response_time>tempo_ms</response_time>
      <response_header/>
    </result>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Resposta OK?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>JSON diário -&gt; linhas</send_true_to>
    <send_false_to>Falhas da API</send_false_to>
    <compare>
      <condition>
        <conditions>
</conditions>
        <function>=</function>
        <leftvalue>status_http</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>200</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Falhas da API</name>
    <type>WriteToLog</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>Falha ao consultar a Open-Meteo para o talhão</logmessage>
    <fields>
      <field><name>codigo</name></field>
      <field><name>status_http</name></field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>336</yloc>
    </GUI>
  </transform>
  <transform>
    <name>JSON diário -&gt; linhas</name>
    <type>JsonInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>Y</removeSourceField>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>Y</doNotFailIfNoFile>
    <ignoreMissingPath>Y</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rownum_field/>
    <file>
      <name/>
      <filemask/>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>data</name>
        <path>$.daily.time[*]</path>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>temp_max</name>
        <path>$.daily.temperature_2m_max[*]</path>
        <type>Number</type>
        <format></format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>temp_min</name>
        <path>$.daily.temperature_2m_min[*]</path>
        <type>Number</type>
        <format></format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>chuva_mm</name>
        <path>$.daily.precipitation_sum[*]</path>
        <type>Number</type>
        <format></format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>et0_mm</name>
        <path>$.daily.et0_fao_evapotranspiration[*]</path>
        <type>Number</type>
        <format></format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>vento_max_kmh</name>
        <path>$.daily.wind_speed_10m_max[*]</path>
        <type>Number</type>
        <format></format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>umidade_media</name>
        <path>$.daily.relative_humidity_2m_mean[*]</path>
        <type>Number</type>
        <format></format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>prob_chuva</name>
        <path>$.daily.precipitation_probability_max[*]</path>
        <type>Number</type>
        <format></format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <IsInFields>Y</IsInFields>
    <IsAFile>N</IsAFile>
    <valueField>response</valueField>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <attributes/>
    <GUI>
      <xloc>704</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Gravar clima_diario</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>agro_mysql</connection>
    <commit>500</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema/>
      <table>clima_diario</table>
      <key>
        <name>talhao_id</name>
        <field>talhao_id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>data</name>
        <field>data</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>talhao_id</name>
        <rename>talhao_id</rename>
        <update>N</update>
      </value>
      <value>
        <name>data</name>
        <rename>data</rename>
        <update>N</update>
      </value>
      <value>
        <name>temp_max</name>
        <rename>temp_max</rename>
        <update>Y</update>
      </value>
      <value>
        <name>temp_min</name>
        <rename>temp_min</rename>
        <update>Y</update>
      </value>
      <value>
        <name>chuva_mm</name>
        <rename>chuva_mm</rename>
        <update>Y</update>
      </value>
      <value>
        <name>et0_mm</name>
        <rename>et0_mm</rename>
        <update>Y</update>
      </value>
      <value>
        <name>vento_max_kmh</name>
        <rename>vento_max_kmh</rename>
        <update>Y</update>
      </value>
      <value>
        <name>umidade_media</name>
        <rename>umidade_media</rename>
        <update>Y</update>
      </value>
      <value>
        <name>prob_chuva</name>
        <rename>prob_chuva</rename>
        <update>Y</update>
      </value>
      <value>
        <name>carregado_por</name>
        <rename>carregado_por</rename>
        <update>Y</update>
      </value>
      <value>
        <name>atualizado_em</name>
        <rename>atualizado_em</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>912</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
