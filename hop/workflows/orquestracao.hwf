<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>orquestracao</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Orquestra a integracao completa do AgroSentinela</description>
  <extended_description/>
  <workflow_version>1.0</workflow_version>
  <created_user>AgroSentinela</created_user>
  <created_date>2026/11/16 10:00:00.000</created_date>
  <modified_user>AgroSentinela</modified_user>
  <modified_date>2026/11/16 10:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>6</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>176</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Verificar MySQL</name>
      <description/>
      <type>CHECK_DB_CONNECTIONS</type>
      <attributes/>
      <connections>
        <connection>
          <name>agro_mysql</name>
          <waitfor>0</waitfor>
          <waittime>millisecond</waittime>
        </connection>
      </connections>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>176</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Coletar clima (Open-Meteo)</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/coleta_clima.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>176</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Consolidar e gerar alertas (Python)</name>
      <description>Limpeza do caderno de campo (SQLite), integracao, DW DuckDB e alertas MongoDB</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}/../backend</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>${PYTHON} -m app.etl.pipeline --pular-coleta</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>176</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Sucesso</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>864</xloc>
      <yloc>176</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Registrar falha</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <logmessage>Falha na integracao AgroSentinela - verifique o log acima.</logmessage>
      <loglevel>Error</loglevel>
      <logsubject>AgroSentinela</logsubject>
      <parallel>N</parallel>
      <xloc>528</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop><from>Start</from><to>Verificar MySQL</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>Verificar MySQL</from><to>Coletar clima (Open-Meteo)</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Coletar clima (Open-Meteo)</from><to>Consolidar e gerar alertas (Python)</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Consolidar e gerar alertas (Python)</from><to>Sucesso</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Verificar MySQL</from><to>Registrar falha</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Coletar clima (Open-Meteo)</from><to>Registrar falha</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Consolidar e gerar alertas (Python)</from><to>Registrar falha</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>210</backgroundcolorblue>
      <backgroundcolorgreen>245</backgroundcolorgreen>
      <backgroundcolorred>220</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>140</bordercolorgreen>
      <bordercolorred>60</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>40</fontcolorblue>
      <fontcolorgreen>60</fontcolorgreen>
      <fontcolorred>30</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Segoe UI</fontname>
      <fontsize>10</fontsize>
      <height>70</height>
      <xloc>64</xloc>
      <yloc>40</yloc>
      <note>AgroSentinela - orquestracao diaria (agende no Start, ex.: todo dia as 06h)
MySQL ok? -> coleta de clima via REST (pipeline) -> consolidacao Python
(SQLite + MySQL -> DuckDB + MongoDB). Qualquer falha cai em "Registrar falha".</note>
      <width>620</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>
